# Optional overrides for derived endpoints and asset base URLs
# Copy to .env.local if you need to override defaults derived from VITE_API_URL.

# Base URL for static assets in the dashboard layout
VITE_BASE_URL=http://localhost:5173

# Explicit API base URLs (defaults to {VITE_API_URL}/api/v1)
VITE_API_BASE_URL=https://api.dudeisland.eu/api/v1
VITE_API_V1_BASE_URL=https://api.dudeisland.eu/api/v1

# Optional: Preview asset endpoints (defaults to {VITE_API_URL}/...)
VITE_MODEL_PREVIEW_URL=https://api.dudeisland.eu/preview/model/
VITE_VIDEO_PREVIEW_URL=https://api.dudeisland.eu/videos/
