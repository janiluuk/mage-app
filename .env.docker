DANGEROUSLY_DISABLE_HOST_CHECK=true

# Single source of truth for API base URL
# All API endpoints (v1, v2, videos, models, etc.) are derived from this
VUE_APP_API_URL=http://localhost/api

# Optional: Override app base URL for sharing links (defaults to VUE_APP_API_URL if not set)
VUE_APP_APP_URL=http://localhost/

# Optional: Mage API service endpoint (separate service)
VUE_APP_MAGE_API_URL=http://localhost/mage-api

# Optional: Override fallback image URL (defaults to {API_URL}/images/notfound.jpg)
VUE_APP_FALLBACK_IMAGE_URL=https://placehold.co/600x400

# Optional: Sample processed video URL for dev modal
VUE_APP_SAMPLE_PROCESSED_VIDEO_URL=https://example.com/processed/sample.mp4

# Backend configuration
# Note: VUE_APP_STABLE_URL is deprecated - stable URL is now fetched from backend /api/config
# The backend server reads STABLE_URL env variable
STABLE_URL=http://stable.localhost

VUE_APP_API_KEY=changeme

FRONTEND_PORT=8080
API_PORT=3000
NGINX_PORT=80
MYSQL_PORT=3306
MYSQL_DATABASE=mage
MYSQL_USER=mage
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=rootsecret
MAGE_API_IMAGE=mage-backend
COMFY_HOST=ffmpeg-worker
