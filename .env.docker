# Docker environment for mage-app frontend
# This file is mounted as /app/.env.local inside the container
# to ensure Vite picks up the correct settings for Docker networking.

DANGEROUSLY_DISABLE_HOST_CHECK=true

# Client-side: use relative /api/v1 so the browser hits the gateway
VITE_API_BASE_URL=/api/v1

# Server-side (Vite proxy target) – not actually used since gateway routes /api
VITE_API_URL=http://laravel-nginx

# App URLs
VITE_APP_URL=http://localhost:8080
VITE_HELPER_API_URL=
VITE_MAGE_API_URL=
VUE_APP_FALLBACK_IMAGE_URL=https://placehold.co/600x400
