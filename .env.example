DANGEROUSLY_DISABLE_HOST_CHECK=true

# Base URL for static assets in the dashboard layout
VITE_BASE_URL=http://localhost:5173

# Single source of truth for API base URL (no trailing /api)
# All API endpoints (v1, v2, videos, models, etc.) are derived from this
VITE_API_URL=https://api.dudeisland.eu

# Explicit API base URLs used by services that call v1 endpoints directly
VITE_API_BASE_URL=https://api.dudeisland.eu/api/v1
VITE_API_V1_BASE_URL=https://api.dudeisland.eu/api/v1

# Optional: Override app base URL for sharing links (defaults to VITE_API_URL if not set)
VITE_APP_URL=https://app.dudeisland.eu

# Optional: Mage API service endpoint (separate service)
VITE_MAGE_API_URL=http://mage.dudeisland.eu:47860

# Optional: Override fallback image URL (defaults to {API_URL}/images/notfound.jpg)
VITE_FALLBACK_IMAGE_URL=https://api.dudeisland.eu/images/notfound.jpg

# Optional: Sample processed video URL for dev modal
VITE_SAMPLE_PROCESSED_VIDEO_URL=https://api.dudeisland.eu/processed/tuba_new.mp4

# Optional: Fallback stable URL (stable URL is now fetched from backend /api/config)
VITE_STABLE_URL=https://stable.dudeisland.eu

# Optional: Preview asset endpoints
VITE_MODEL_PREVIEW_URL=https://api.dudeisland.eu/preview/model/
VITE_VIDEO_PREVIEW_URL=https://api.dudeisland.eu/videos/

# Optional: Demo-mode flag for profile editing (1 = demo mode)
VITE_IS_DEMO=1

# Optional: Deforum websocket URL for StoryCreator
VITE_APP_DEFORUM_WS_URL=wss://api.dudeisland.eu/deforum/ws
